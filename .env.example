COMPOSE_PROJECT_NAME=gridmitra

POSTGRES_DB=gridmitra
POSTGRES_USER=gridmitra
POSTGRES_PASSWORD=gridmitra_local_only
DATABASE_URL=postgresql+asyncpg://gridmitra:gridmitra_local_only@db:5432/gridmitra

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Empty = same-origin via the Vite /api proxy (recommended). Set to a full URL
# only when the frontend talks to a remote API directly.
VITE_API_URL=
VITE_PROXY_TARGET=http://backend:8000
